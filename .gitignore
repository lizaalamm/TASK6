# Create or overwrite .gitignore
cat > .gitignore << EOF
# Dependencies
node_modules/
package-lock.json
yarn.lock

# Build outputs
dist/
build/
.DS_Store

# Environment files
.env
.env.local
.env.production

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# System files
Thumbs.db
Desktop.ini
EOF